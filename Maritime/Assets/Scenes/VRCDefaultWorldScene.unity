  - {fileID: 8300000, guid: f14fe312899bc1242bc3e4b3a159e2f6, type: 3}
  subtitleLines:
  - "\u3088\u3046\u3053\u305D\u3001\u60D1\u661F\u89B3\u6E2C\u3078\u3002"
  - "\u3053\u308C\u304B\u3089\u592A\u967D\u7CFB\u306E\u60D1\u661F\u305F\u3061\u3092\u3001\u592A\u967D\u306B\u8FD1\u3044\u9806\u756A\u3067\u3054\u6848\u5185\u3057\u3066\u3044\u304D\u307E\u3059\u3002"
  - "\u307E\u305A\u306F\u3053\u3061\u3089\u3001\u592A\u967D\u7CFB\u306E\u4E2D\u5FC3\u3067\u8F1D\u304D\u7D9A\u3051\u308B\u592A\u967D\u3067\u3059\u3002"
  - "\u8868\u9762\u6E29\u5EA6\u306F\u304A\u3088\u305D6000\u5EA6\u3002"
  - "\u5185\u90E8\u3067\u306F\u4ECA\u3053\u306E\u77AC\u9593\u3082\u6838\u878D\u5408\u53CD\u5FDC\u304C\u8D77\u304D\u3066\u3044\u3066\u3001\u305D\u306E\u30A8\u30CD\u30EB\u30AE\u30FC\u304C\u5149\u3068\u306A\u3063\u3066\u5730\u7403\u307E\u3067\u5C4A\u3044\u3066\u3044\u307E\u3059\u3002"
  - "\u591C\u7A7A\u3092\u898B\u4E0A\u3052\u3089\u308C\u308B\u306E\u3082\u3001\u3053\u3046\u3057\u3066\u751F\u304D\u3066\u3044\u3089\u308C\u308B\u306E\u3082\u3001\u5B9F\u306F\u3053\u306E\u4E00\u3064\u306E\u661F\u306E\u304A\u304B\u3052\u306A\u3093\u3067\u3059\u306D\u3002"
  - "\u305D\u308C\u3067\u306F\u6B21\u306F\u3001\u592A\u967D\u306B\u4E00\u756A\u8FD1\u3044\u60D1\u661F\u3001\u6C34\u661F\u3092\u3054\u89A7\u3044\u305F\u3060\u304D\u307E\u3057\u3087\u3046\u3002"
  - "\u592A\u967D\u306B\u4E00\u756A\u8FD1\u3044\u3068\u3053\u308D\u3092\u3050\u308B\u3050\u308B\u56DE\u3063\u3066\u3044\u308B\u3001\u5C0F\u3055\u306A\u7070\u8272\u306E\u60D1\u661F\u3067\u3059\u3002"
  - "\u663C\u3068\u591C\u3067\u6E29\u5EA6\u5DEE\u304C\u306A\u3093\u3068600\u5EA6\u4EE5\u4E0A\u3002"
  - "\u5927\u6C17\u304C\u307B\u3068\u3093\u3069\u306A\u3044\u306E\u3067\u3001\u30AF\u30EC\u30FC\u30BF\u30FC\u3060\u3089\u3051\u306E\u7D20\u9854\u304C\u305D\u306E\u307E\u307E\u5265\u304D\u51FA\u3057\u306B\u306A\u3063\u3066\u3044\u307E\u3059\u3002"
  - "\u592A\u967D\u306E\u5468\u308A\u3092\u305F\u3063\u305F88\u65E5\u3067\u4E00\u5468\u3057\u3066\u3057\u307E\u3046\u3001\u592A\u967D\u7CFB\u30A4\u30C1\u8DB3\u306E\u901F\u3044\u60D1\u661F\u3067\u3082\u3042\u308B\u3093\u3067\u3059\u3002"
  - "\u7D9A\u3044\u3066\u306F\u3001\u660E\u3051\u306E\u660E\u661F\u30FB\u5BB5\u306E\u660E\u661F\u3068\u3057\u3066\u77E5\u3089\u308C\u308B\u91D1\u661F\u3092\u3054\u7D39\u4ECB\u3057\u307E\u3057\u3087\u3046\u3002"
  - "\u660E\u3051\u65B9\u3084\u5915\u65B9\u3001\u3072\u3068\u304D\u308F\u660E\u308B\u304F\u8F1D\u3044\u3066\u3044\u308B\u306E\u3092\u898B\u305F\u3053\u3068\u306F\u3042\u308A\u307E\u305B\u3093\u304B\u3002"
  - "\u305D\u308C\u304C\u91D1\u661F\u3067\u3059\u3002"
  - "\u5206\u539A\u3044\u96F2\u306B\u5305\u307E\u308C\u3066\u3044\u3066\u3001\u5F37\u70C8\u306A\u6E29\u5BA4\u52B9\u679C\u306E\u305B\u3044\u3067\u8868\u9762\u306F\u306A\u3093\u3068450\u5EA6\u3002"
  - "\u5730\u7403\u3068\u307B\u307C\u540C\u3058\u5927\u304D\u3055\u306A\u306E\u3067\u3001\u6614\u306F\u300C\u53CC\u5B50\u306E\u661F\u300D\u306A\u3093\u3066\u547C\u3070\u308C\u3066\u3044\u307E\u3057\u305F\u3002"
